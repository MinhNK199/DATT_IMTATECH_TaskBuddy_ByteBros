{
  "info": {
    "_postman_id": "taskbuddy-collection-001",
    "name": "TaskBuddy API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection cho toàn bộ API backend TaskBuddy. Nhớ thêm Bearer Token (Firebase) vào Authorization."
  },
  "item": [
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Tạo task mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Học React\",\n  \"description\": \"Xem tài liệu ReactJS\",\n  \"category\": \"study\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2024-07-01T23:59:59.000Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tasks",
              "host": ["{{base_url}}"],
              "path": ["tasks"]
            }
          },
          "response": []
        },
        {
          "name": "Lấy danh sách task",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/tasks?status=in_progress",
              "host": ["{{base_url}}"],
              "path": ["tasks"],
              "query": [
                { "key": "status", "value": "in_progress" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cập nhật task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tasks/{{taskId}}",
              "host": ["{{base_url}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Xóa task",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{taskId}}",
              "host": ["{{base_url}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Gợi ý lộ trình AI",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/ai/schedule",
              "host": ["{{base_url}}"],
              "path": ["ai", "schedule"]
            }
          },
          "response": []
        },
        {
          "name": "Insights năng suất",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/ai/insights",
              "host": ["{{base_url}}"],
              "path": ["ai", "insights"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Tạo báo cáo mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"weekly\",\n  \"startDate\": \"2024-06-01\",\n  \"endDate\": \"2024-06-07\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/reports",
              "host": ["{{base_url}}"],
              "path": ["reports"]
            }
          },
          "response": []
        },
        {
          "name": "Lấy dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/reports/dashboard",
              "host": ["{{base_url}}"],
              "path": ["reports", "dashboard"]
            }
          },
          "response": []
        },
        {
          "name": "Xuất PDF báo cáo",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/reports/{{reportId}}/pdf",
              "host": ["{{base_url}}"],
              "path": ["reports", "{{reportId}}", "pdf"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Lấy profile user",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users/profile",
              "host": ["{{base_url}}"],
              "path": ["users", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "Cập nhật preferences",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"theme\": \"dark\",\n  \"notifications\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/preferences",
              "host": ["{{base_url}}"],
              "path": ["users", "preferences"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "reportId", "value": "" }
  ]
} 